# PRIVATE SERVER VARIABLES (set in Vercel Project > Environment Variables)
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=https://your-vercel-domain.vercel.app
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=dengueye
DB_USER=dengueye
DB_PASSWORD=change_me
DB_POOL_MAX=20
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_TTL_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
REQUEST_TIMEOUT_MS=5000
UPLOAD_MAX_BYTES=5242880
LOG_LEVEL=info

# PUBLIC FRONTEND VARIABLES (Vite requires VITE_ prefix)
# Optional: set a base API URL for the frontend if not using relative `/api` paths
VITE_API_BASE=
